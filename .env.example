# Site URL (production) — used for SEO, Open Graph, canonical links
VITE_SITE_URL=https://nurujjaman.dev

# Firebase (optional — enables admin CMS + Firestore projects)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Admin panel (optional — client-side password check only)
# VITE_ADMIN_PASSWORD=

# Contact form — https://web3forms.com/
# VITE_WEB3FORMS_ACCESS_KEY=

# Analytics — https://plausible.io/ (privacy-friendly, optional)
# VITE_PLAUSIBLE_DOMAIN=nurujjaman.dev
